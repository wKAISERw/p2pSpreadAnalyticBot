# Шаблон конфіга. Змінні ${SCANNER_UPSTREAM} і ${ARBIX_API_KEY} підставляє
# envsubst у entrypoint-і образу nginx при старті контейнера.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Хешовані ассети Vite незмінні — тримаємо їх у кеші довго.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA: будь-який маршрут віддає index.html, роутинг далі робить React Router.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Проксі на сканер. Ключ додається саме тут — браузер його не бачить,
    # тож спільний секрет не роз'їжджається по всіх, хто відкрив дашборд.
    location /api/ {
        proxy_pass http://${SCANNER_UPSTREAM};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-API-Key "${ARBIX_API_KEY}";

        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }
}
