# --- TELEGRAM CONFIGURATION ---
# Токен вашого бота від @BotFather
TELEGRAM_BOT_TOKEN=
# ID чату або каналу для сповіщень
TELEGRAM_CHAT_ID=
# Токен Wallet Pay API (якщо використовується)
WALLET_TOKEN=
# Telegram API ID та Hash (потрібні для роботи клієнта/юзербота)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Telegram ID адміністратора (для доступу до керування)
ADMIN_ID=
# Ключ для шифрування API-ключів користувачів у БД (можна згенерувати через cryptography.fernet.Fernet.generate_key().decode())
ENCRYPTION_KEY=

# --- GOOGLE / FIREBASE CONFIGURATION ---
# Шлях до файлу сервісного акаунту Firebase
GOOGLE_APPLICATION_CREDENTIALS=firebase-adminsdk.json

# --- LLM API KEYS (АНТИФРОД ТА РИЗИК-АНАЛІЗ) ---
# Ключі для роботи з LLM моделями
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- МОДЕЛІ ДЛЯ АНАЛІЗУ ---
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile

# --- РЕЖИМ БЕЗПЕКИ RISK ENGINE ---
# Рівні логування/блокування ризиків (INFO, WARNING, BLOCK, OFF)
RISK_MODE=WARNING

# --- РОБОЧІ ПАРАМЕТРИ СКАНУВАННЯ ---
# Робочий капітал в UAH
WORKING_CAPITAL_UAH=5100.0
# Мінімальний спред у відсотках
MIN_SPREAD_PCT=0.5
# Поріг відсікання дрібних ордерів в USDT
MIN_USDT_THRESHOLD=50.0
# Список сум для симуляції склянки та розрахунку спреду
SEARCH_AMOUNTS_UAH=[1000.0, 2500.0, 5100.0]

# --- НАЛАШТУВАННЯ АЛГОРИТМІВ ---
# Метод розрахунку аномальних відхилень цін (mean, median, mad)
ANOMALY_METHOD=mad
# Коефіцієнт відхилення для фільтрації аномалій
ANOMALY_THRESHOLD_MULTIPLIER=2.5
# Суворе дедуплікування а alert dispatcher
DEDUP_STRICT=False

# --- СИСТЕМНІ НАЛАШТУВАННЯ ---
# Рівень логування (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Адреса проксі-сервера (опціонально, наприклад: http://user:pass@host:port)
PROXY_URL=
# Тестовий режим (true - блокує реальні POST запити виставлення ордерів на біржі)
DRY_RUN_MODE=true
