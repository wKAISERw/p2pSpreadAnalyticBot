# --- TELEGRAM CONFIGURATION ---
# Токен вашого бота від @BotFather
TELEGRAM_BOT_TOKEN=
# ID чату або каналу для сповіщень
TELEGRAM_CHAT_ID=
# Токен Wallet Pay API (якщо використовується)
WALLET_TOKEN=
# Telegram API ID та Hash (потрібні для роботи клієнта/юзербота)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Telegram ID адміністратора (для доступу до керування)
ADMIN_ID=
# --- HTTP API (дашборд + букмарклет сесій) ---
# Спільний секрет для /api/v1/*. Передається заголовком X-API-Key,
# або ?api_key= для букмарклета (він не вміє слати заголовки).
# Згенерувати: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ПОРОЖНЄ ЗНАЧЕННЯ = API відкритий усім, хто дістає порт 8000.
API_KEY=
# Дозволені Origin для браузерного фронтенду, через кому. За замовчуванням ["*"].
# CORS_ORIGINS=["https://my-dashboard.example"]
# Ключ підпису session-токенів дашборду. Якщо порожній — використовується
# похідна від TELEGRAM_BOT_TOKEN. Задай окремо, якщо колись мінятимеш токен
# бота і не хочеш розлогінити всіх користувачів сайту.
# SESSION_SECRET=
# Чи вважати наявність X-API-Key достатньою, щоб читати й писати дані
# будь-якого користувача через ?telegram_id=. За замовчуванням false.
#
# Вмикати НЕ треба, якщо дашборд стоїть за проксі з deploy/Caddyfile: там
# ключ підставляється кожному відвідувачу, і true перетворює ?telegram_id=
# на публічний доступ до чужих балансів, карток і ключів бірж.
# Має сенс лише для разових скриптів оператора на закритому порту.
# API_KEY_IS_IDENTITY=false

# Ключ для шифрування API-ключів користувачів у БД (можна згенерувати через cryptography.fernet.Fernet.generate_key().decode())
ENCRYPTION_KEY=

# --- GOOGLE / FIREBASE CONFIGURATION ---
# Шлях до файлу сервісного акаунту Firebase
GOOGLE_APPLICATION_CREDENTIALS=firebase-adminsdk.json

# --- LLM API KEYS (АНТИФРОД ТА РИЗИК-АНАЛІЗ) ---
# Ключі для роботи з LLM моделями
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- МОДЕЛІ ДЛЯ АНАЛІЗУ ---
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile

# --- РЕЖИМ БЕЗПЕКИ RISK ENGINE ---
# Рівні логування/блокування ризиків (INFO, WARNING, BLOCK, OFF)
RISK_MODE=WARNING

# --- РОБОЧІ ПАРАМЕТРИ СКАНУВАННЯ ---
# Робочий капітал в UAH
WORKING_CAPITAL_UAH=5100.0
# Мінімальний спред у відсотках
MIN_SPREAD_PCT=0.5
# Поріг відсікання дрібних ордерів в USDT
MIN_USDT_THRESHOLD=50.0
# Список сум для симуляції склянки та розрахунку спреду
SEARCH_AMOUNTS_UAH=[1000.0, 2500.0, 5100.0]

# --- НАЛАШТУВАННЯ АЛГОРИТМІВ ---
# Фільтр цінових аномалій у тейкер-режимах. Відсіює оголошення, ціна яких
# різко вибивається з ринку в ТВОЮ користь — це майже завжди замануха в чат
# або помилка мерчанта. Невигідні ціни не чіпає: їх і так відсіють пороги.
#
# Як міряти розкид ринку:
#   mad    — медіанне відхилення, найстійкіше до викидів (рекомендовано)
#   median — середнє відхилення від медіани
#   mean   — стандартне відхилення від середнього
ANOMALY_METHOD=mad
# Скільки таких розкидів від центру вважати нормою. Більше = м'якше.
# Значення однакове за змістом для всіх трьох методів.
# Незалежно від нього, відрив менший за 3% аномалією не вважається ніколи —
# інакше на щільному стакані під ніж потрапляла б найкраща ціна.
ANOMALY_THRESHOLD_MULTIPLIER=2.5
# Суворе дедуплікування а alert dispatcher
DEDUP_STRICT=False

# --- СИСТЕМНІ НАЛАШТУВАННЯ ---
# Рівень логування (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Адреса проксі-сервера (опціонально, наприклад: http://user:pass@host:port)
PROXY_URL=
# Тестовий режим (true - блокує реальні POST запити виставлення ордерів на біржі)
DRY_RUN_MODE=true
