# ─── Адреса API бота ─────────────────────────────────────────────────────
# Для локальної розробки — прямий шлях на бота.
# У продакшені лишається порожнім: там запити йдуть на той самий origin,
# а Caddy перекидає /api на сканер (див. deploy/Caddyfile).
VITE_API_URL=http://localhost:8000/api/v1

# Ключ для локальної розробки. У продакшені НЕ потрібен: його підставляє
# проксі, і в бандл він не потрапляє.
# VITE_API_KEY=

# ─── Тільки для деплою (docker compose на сервері) ───────────────────────
# Порожньо → HTTP на IP сервера.
# Домен → Caddy сам випустить сертифікат Let's Encrypt і ввімкне HTTPS.
# ARBIX_SITE_ADDRESS=arbixquantum.duckdns.org
# ARBIX_ACME_EMAIL=you@example.com

# Те саме значення, що API_KEY у .env бота.
# ARBIX_API_KEY=

# Ім'я контейнера сканера, якщо воно відрізняється.
# SCANNER_UPSTREAM=arbix_quantum_scanner:8000
